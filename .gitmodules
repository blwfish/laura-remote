[submodule "firmware/vendor/cmsis-core"]
	path = firmware/vendor/cmsis-core
	url = https://github.com/STMicroelectronics/cmsis-core.git
[submodule "firmware/vendor/cmsis-device-wl"]
	path = firmware/vendor/cmsis-device-wl
	url = https://github.com/STMicroelectronics/cmsis_device_wl.git
[submodule "firmware/vendor/stm32wlxx-hal-driver"]
	path = firmware/vendor/stm32wlxx-hal-driver
	url = https://github.com/STMicroelectronics/stm32wlxx_hal_driver.git
[submodule "firmware/vendor/subghz-phy"]
	path = firmware/vendor/subghz-phy
	url = https://github.com/STMicroelectronics/stm32-mw-subghz-phy.git
